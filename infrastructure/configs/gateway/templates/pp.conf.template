server {
  include /etc/nginx/includes/listen.conf;
  server_name ~^alex\.(?<pp_namespace>[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)\.(?:localhost|workspace-gateway-pod)$;
  include /etc/nginx/includes/ssl.conf;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
  resolver_timeout 2s;

  location / {
      set $upstream $pp_namespace-pp3-frontend-pod:8090;
      include /etc/nginx/includes/proxy.conf;
      proxy_pass http://$upstream;
  }

  location /pp-vendor {
      set $upstream $pp_namespace-pp3-frontend-pod:8091;
      include /etc/nginx/includes/proxy.conf;
      proxy_pass http://$upstream;
  }

  location /vendormodule {
      set $upstream $pp_namespace-pp3-frontend-pod:8091;
      include /etc/nginx/includes/proxy.conf;
      proxy_pass http://$upstream;
  }

  location /pp-public {
      set $upstream $pp_namespace-pp3-frontend-pod:8092;
      include /etc/nginx/includes/proxy.conf;
      proxy_pass http://$upstream;
  }

  location /public {
      set $upstream $pp_namespace-pp3-frontend-pod:8092;
      include /etc/nginx/includes/proxy.conf;
      proxy_pass http://$upstream;
  }

  location /pp {
      set $upstream $pp_namespace-isms-frontend-pod:3004;
      include /etc/nginx/includes/proxy.conf;
      proxy_pass http://$upstream;
  }

  location /isms {
      set $upstream $pp_namespace-isms-frontend-pod:3004;
      include /etc/nginx/includes/proxy.conf;
      proxy_pass http://$upstream;
  }

#   location /isms {
