{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "model": "openai/gpt-6.2-sol",
  "compaction": {
    "auto": true
  },
  "experimental": {
    "subagent_depth": 1,
    "todo": true
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "environment": {
          "NODE_TLS_REJECT_UNAUTHORIZED": "1"
        },
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://workspace-chromium-pod:9223",
          "--no-usage-statistics",
          "--experimental-devtools",
          "--category-experimental-webmcp"
        ]
      },
      "presswork": {
        "type": "remote",
        "url": "https://presswork.appfusion.workspace-gateway-pod:8443/api/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer 1b9f2e11-e0f1-44f9-8ca3-f60c3378aacb"
        }
      }
    }
  }
}
