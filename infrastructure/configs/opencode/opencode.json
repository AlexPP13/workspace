{
  "$schema": "https://opencode.ai/config.json",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" }
  ],
  "model": "openai/gpt-6.1-sol",
  "compaction": {
    "auto": true
  },
  "experimental": {
    "subagent_depth": 1,
    "todo": true
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-6-luna": {
          "variants": [
            {
              "id": "delegation-low",
              "settings": { "reasoningEffort": "low", "textVerbosity": "low" }
            }
          ]
        },
        "gpt-6.1-sol": {
          "variants": [
            {
              "id": "delegation-medium",
              "settings": { "reasoningEffort": "medium", "textVerbosity": "low" }
            }
          ]
        },
        "gpt-6-astra": {
          "variants": [
            {
              "id": "delegation-high",
              "settings": { "reasoningEffort": "high", "textVerbosity": "low" }
            }
          ]
        }
      }
    }
  },
  "agents": {
    "title": {
      "model": "openai/gpt-6.1-sol#delegation-medium"
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://workspace-chromium-pod:9223",
          "--no-usage-statistics",
          "--experimental-devtools",
          "--category-experimental-webmcp"
        ],
        "environment": {
          "npm_config_cache": "/home/core/.cache/npm-devtools-mcp"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--cdp-endpoint",
          "http://workspace-chromium-pod:9223",
        ],
      },
      "rovo": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "oauth": {},
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  }
}
