.PHONY: kube play gateway-alias down workspace resources validate tls certificate mkcert

NAMESPACE=workspace
USERNS=--userns=keep-id:uid=1001,gid=0
IMAGE_PULL_POLICY?=IfNotPresent
# IMAGE_PULL_POLICY?=Always
export WORKSPACE_PATH ?= $(CURDIR)

# Generate deployment from Helm Chart
kube:
	@printf '☸️  Rendering Kubernetes manifest for namespace: %s\n' '$(NAMESPACE)'; \
	printf '📥 Image pull policy: %s\n' '$(IMAGE_PULL_POLICY)'; \
	podman run \
		-i \
		--rm \
		-v ./infrastructure:/infrastructure:Z \
		-w /infrastructure \
		--env WORKSPACE_PATH \
		--entrypoint sh \
		docker.io/alpine/helm:latest \
		-c 'helm template $(NAMESPACE) \
			--dry-run=client \
			--values ./values.yaml \
			--set-string deployments.containers.pullPolicy=$(IMAGE_PULL_POLICY) \
			--set-literal "deployments.workspacePath=$$WORKSPACE_PATH" \
			. > ./kube.yaml.tmp && mv ./kube.yaml.tmp ./kube.yaml' && \
	printf '✅ Kubernetes manifest generated: infrastructure/kube.yaml\n'

# Lint the chart and schema-check the existing manifest generated by kube
validate:
	@printf '🔎 Validating manifest: infrastructure/kube.yaml\n'; \
	if [ ! -s ./infrastructure/kube.yaml ]; then \
		printf '❌ Manifest missing or empty; run make kube first\n' >&2; \
		exit 1; \
	fi; \
	printf '📋 Linting Helm chart\n'; \
	podman run \
		--rm \
		-v ./infrastructure:/infrastructure:ro,Z \
		-w /infrastructure \
		docker.io/alpine/helm:latest \
		lint . \
		--values ./values.yaml \
		--set-literal "deployments.workspacePath=$$WORKSPACE_PATH" \
		--set-string deployments.containers.pullPolicy=$(IMAGE_PULL_POLICY) && \
	printf '📋 Checking generated manifest schemas\n' && \
	podman run \
		-i \
		--rm \
		ghcr.io/yannh/kubeconform:latest \
		-strict \
		-summary < ./infrastructure/kube.yaml && \
	printf '✅ Validation passed (not a Podman compatibility or readiness check)\n'

# Run with Podman
play: down
	@printf '🚀 Starting %s\n' '$(NAMESPACE)'; \
	podman kube play $(USERNS) ./infrastructure/kube.yaml && \
	printf '📋 Pods for %s\n' '$(NAMESPACE)' && \
	podman pod ls | grep $(NAMESPACE) && \
	printf '✅ %s started from infrastructure/kube.yaml\n' '$(NAMESPACE)'

# Add a DNS alias to the running gateway only; reconnecting interrupts traffic.
gateway-alias: export GATEWAY_ALIAS = $(ALIAS)
gateway-alias: export GATEWAY_POD = $(NAMESPACE)-gateway-pod
gateway-alias:
	@bash -ec '\
		alias_name=$$GATEWAY_ALIAS; \
		if [[ ! $$alias_name =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)*$$ ]]; then \
			printf "Usage: make gateway-alias NAMESPACE=workspace ALIAS=alex.pp123.workspace-gateway-pod\n" >&2; \
			exit 2; \
		fi; \
		network=podman-default-kube-network; \
		infra=$$(podman pod inspect --format "{{.InfraContainerID}}" "$$GATEWAY_POD"); \
		current=$$(podman inspect --format "{{with index .NetworkSettings.Networks \"$$network\"}}{{range .Aliases}}{{printf \"%s \" .}}{{end}}{{else}}-{{end}}" "$$infra"); \
		if [[ $$current == - ]]; then \
			printf "%s is not attached to %s\n" "$$GATEWAY_POD" "$$network" >&2; \
			exit 1; \
		fi; \
		read -r -a aliases <<< "$$current"; \
		alias_args=(); \
		for existing in "$${aliases[@]}"; do \
			if [[ $${existing,,} == $${alias_name,,} ]]; then \
				printf "%s already has alias %s\n" "$$GATEWAY_POD" "$$alias_name"; \
				exit 0; \
			fi; \
			alias_args+=(--alias "$$existing"); \
		done; \
		podman network disconnect "$$network" "$$infra"; \
		if ! podman network connect "$${alias_args[@]}" --alias "$$alias_name" "$$network" "$$infra"; then \
			printf "Could not add %s; restoring the previous gateway aliases\n" "$$alias_name" >&2; \
			podman network connect "$${alias_args[@]}" "$$network" "$$infra"; \
			exit 1; \
		fi; \
		printf "Added alias %s to %s\n" "$$alias_name" "$$GATEWAY_POD"'

# Stop the deployment with Podman
down:
	@printf '🛑 Stopping %s from manifest: %s\n' '$(NAMESPACE)' 'infrastructure/kube.yaml'; \
	podman kube down --force ./infrastructure/kube.yaml && \
	printf '✅ %s stopped\n' '$(NAMESPACE)'

# Stop existing pods, render the chart, and start it with Podman
workspace: down kube play
	@printf '✅ %s is ready\n' '$(NAMESPACE)'

resources:
	@printf '📦 Resources for %s\n' '$(NAMESPACE)'; \
	for resource in pod volume network; do \
		case "$$resource" in pod) label='📦 Pods' ;; volume) label='💾 Volumes' ;; network) label='🌐 Networks' ;; esac; \
		printf '\n%s\n' "$$label"; \
		listing=$$(podman "$$resource" ls) || exit $$?; \
		matches=$$(printf '%s\n' "$$listing" | grep -F -- "$(NAMESPACE)"); \
		status=$$?; \
		if [ $$status -eq 0 ]; then \
			printf '%s\n' "$$listing" | sed -n '1p'; \
			printf '%s\n' "$$matches"; \
		elif [ $$status -eq 1 ]; then \
			printf '(none)\n'; \
		else exit $$status; fi; \
	done

# Generate a local development TLS certificate for localhost subdomains
tls:
	@if test -s ./infrastructure/secrets/gateway/tls.crt && test -s ./infrastructure/secrets/gateway/tls.key; then :; \
	elif test ! -e ./infrastructure/secrets/gateway/tls.crt && test ! -e ./infrastructure/secrets/gateway/tls.key; then $(MAKE) certificate; \
	else printf '%s\n' 'Incomplete gateway TLS pair; restore both tls.crt and tls.key before starting.' >&2; exit 1; fi

certificate:
	@mkdir -p ./infrastructure/secrets/gateway
	@umask 077; podman run --rm \
	-v ./infrastructure/secrets/gateway:/certs:Z \
	docker.io/alpine/openssl:latest req -x509 -noenc -sha256 -days 365 -newkey rsa:2048 -keyout /certs/tls.key -out /certs/tls.crt -subj "/C=US/ST=workspace/L=workspace/O=workspace/CN=localhost" -addext "subjectAltName=DNS:localhost,DNS:*.localhost,DNS:*.workspace.localhost,DNS:*.appfusion.localhost,DNS:alexbrasser.com,DNS:*.alexbrasser.com,DNS:*.workspace.alexbrasser.com,DNS:*.appfusion.alexbrasser.com"

# Generate a locally trusted TLS certificate and trust its CA in Ungoogled Chromium.
# Restart Chromium after running this target to load the updated NSS database.
mkcert:
	@podman run --rm --userns=keep-id --security-opt label=disable \
		-v ./infrastructure/secrets/gateway:/certs \
		-v "$$HOME/.local/share:/mkcert-data" \
		-v "$$HOME/.var/app/io.github.ungoogled_software.ungoogled_chromium:/chromium-data" \
		-e CAROOT=/mkcert-data/mkcert \
		--entrypoint sh docker.io/alpine/mkcert:latest -ec '\
			mkdir -p /mkcert-data/mkcert /chromium-data/data/pki/nssdb; \
			mkcert -cert-file /certs/tls.crt -key-file /certs/tls.key localhost "*.localhost" "*.workspace.localhost" "*.appfusion.localhost" alexbrasser.com "*.alexbrasser.com" "*.workspace.alexbrasser.com" "*.appfusion.alexbrasser.com"; \
			if [ ! -f /chromium-data/data/pki/nssdb/cert9.db ]; then certutil -d sql:/chromium-data/data/pki/nssdb -N --empty-password; fi; \
			certutil -d sql:/chromium-data/data/pki/nssdb -D -n "mkcert local development CA" 2>/dev/null || true; \
			certutil -d sql:/chromium-data/data/pki/nssdb -A -n "mkcert local development CA" -t "C,," -i /mkcert-data/mkcert/rootCA.pem'
